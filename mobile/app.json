{
  "expo": {
    "name": "WealthMaster",
    "slug": "wealthmaster",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "wealthmaster",
    "userInterfaceStyle": "dark",
    "android": {
      "package": "com.wealthmaster.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#0A0A0F"
      },
      "permissions": [
        "USE_BIOMETRIC",
        "USE_FINGERPRINT",
        "INTERNET",
        "VIBRATE"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow WealthMaster to use Face ID for authentication"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
