{
  "name": "wealthmaster-backend",
  "version": "1.0.0",
  "description": "WealthMaster API Server - Fastify + TypeScript",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "lint": "eslint src/ --ext .ts",
    "typecheck": "tsc --noEmit",
    "test": "jest --passWithNoTests",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "fastify": "^5.2.0",
    "@fastify/cors": "^10.0.0",
    "@fastify/jwt": "^9.0.0",
    "@fastify/rate-limit": "^10.2.0",
    "@prisma/client": "^6.3.0",
    "ioredis": "^5.4.0",
    "axios": "^1.7.0",
    "zod": "^3.23.0",
    "dotenv": "^16.4.0",
    "date-fns": "^4.1.0"
  },
  "devDependencies": {
    "typescript": "~5.7.0",
    "tsx": "^4.19.0",
    "@types/node": "^22.0.0",
    "prisma": "^6.3.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "jest": "^29.0.0",
    "@types/jest": "^29.0.0"
  }
}
